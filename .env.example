# RoutePilot AI: environment variable names and meanings. NO real values here.
# Enter real values ONLY in your host's secure dashboard (Vercel -> Project -> Settings -> Environment Variables).
# Keep Preview and Production values separate. Never commit a filled-in .env file.

# ---- Site -----------------------------------------------------------------
# REQUIRED in production. Public https origin, no trailing slash. Used for OAuth redirects and CSRF origin checks.
APP_ORIGIN=
# Optional comma-separated extra origins allowed to call the API (e.g. preview URLs). Never "*".
ALLOWED_ORIGINS=

# ---- Auth (Supabase) --------------------------------------------------------
# Public: safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server only. Needed for account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth client id/secret are configured INSIDE the Supabase dashboard (Auth -> Providers -> Google), not here.

# ---- Bot protection (Cloudflare Turnstile) ----------------------------------
# Secret key enables server-side verification on anonymous search. Leave unset in dev.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Rate limiting (Upstash Redis) -----------------------------------------
# REQUIRED for production on serverless: without these, limits are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- LLM (optional; rule-based parser is used when unset) -----------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Set to "false" to disable LLM use without removing the key.
LLM_ENABLED=

# ---- Live flight fares (Duffel) ---------------------------------------------------
# Test token: Duffel dashboard -> More -> Developers -> Access tokens. SECRET: server only. Leave empty for demo data.
DUFFEL_ACCESS_TOKEN=
# Rupees per 1 unit of each currency Duffel may price in; offers in a currency without a rate are skipped, never guessed.
# Example: {"USD":85,"EUR":92,"GBP":108,"AED":23}
DUFFEL_FX_RATES=

# ---- Providers / feature flags ------------------------------------------------
# Comma-separated provider ids to switch off immediately (e.g. demo-buses,your-flight-provider).
DISABLED_PROVIDERS=
# Webhook signing secrets: one per provider: WEBHOOK_SECRET_<PROVIDER_ID_UPPERCASE_WITH_UNDERSCORES>
# e.g. WEBHOOK_SECRET_YOUR_PROVIDER=

# ---- Payments (OFF unless PAYMENTS_ENABLED=true AND a gateway's variables below are all set) -------------
# Money is only ever collected for bookings that can actually be fulfilled (needs a live booking provider).
PAYMENTS_ENABLED=
# PhonePe Standard Checkout v2 (UPI, cards). Get these from the PhonePe Business dashboard. SECRETS: server only.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Webhook credentials you choose in the PhonePe dashboard; PhonePe sends SHA256(username:password) with each callback.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# PayPal (international cards/accounts). PayPal cannot receive INR on Indian accounts, so charges are converted.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id shown in the PayPal developer dashboard after you add https://YOUR-DOMAIN/api/payments/webhook/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Rupees per 1 unit of PAYPAL_CURRENCY (e.g. 85 means 1 USD = INR 85). YOU keep this current; it is shown to the buyer.
PAYPAL_INR_PER_UNIT=

# ---- Storage ----------------------------------------------------------------
# Production refuses the in-memory store. A durable Postgres store adapter is required before enabling bookings
# (see BUILD_STATUS.md). "memory-unsafe" exists only for throwaway demos and loses data on every restart.
STORE_DRIVER=

# ---- Development only (ignored when NODE_ENV=production) -------------------------
ALLOW_DEV_AUTH=
